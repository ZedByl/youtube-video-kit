      "id": "d60a9859-42de-4fa6-9735-a2637b57c479",
      "name": "GH list stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "githubToken",
          "name": "GitHub token"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Находит вчерашний (последний до сегодня) снимок для дельты и sha сегодняшнего файла, если запуск повторный.\nconst today = $now.setZone('Europe/Berlin').toFormat('yyyy-MM-dd');\nconst todayName = `${today}-channel-stats.md`;\nconst files = $input.all()\n  .map(i => i.json)\n  .filter(f => f && f.type === 'file' && /^\\d{4}-\\d{2}-\\d{2}-channel-stats\\.md$/.test(f.name));\nconst prev = files.filter(f => f.name < todayName).sort((a, b) => a.name.localeCompare(b.name)).pop();\nconst todayFile = files.find(f => f.name === todayName);\n\nreturn [{\n  json: {\n    today,\n    path: `docs/raw/stats/${todayName}`,\n    prevPath: prev ? prev.path : null,\n    todaySha: todayFile ? todayFile.sha : null,\n  },\n}];\n"
      },
      "id": "0690f542-bb6a-44fb-83d6-a9fbf1c79e77",
      "name": "Pick previous",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Config').first().json.githubOwner }}/{{ $('Config').first().json.githubRepo }}/contents/{{ $json.prevPath || 'docs/raw/stats/.gitkeep' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "User-Agent",
              "value": "n8n-channel-project"
            }
          ]
        },
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "ref",
              "value": "={{ $('Config').first().json.branch }}"
            }
          ]
        }
      },
      "id": "c7526ddc-4f29-4b33-8513-3bf1fc0bdd34",
      "name": "GH prev snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "githubToken",
          "name": "GitHub token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst pick = $('Pick previous').first().json;\nconst ch = ($('YT channel').first().json.items || [])[0];\nif (!ch) throw new Error(`Канал ${cfg.channelId} не найден в YouTube Data API`);\nconst vids = $('YT videos').first().json.items || [];\n\n// Предыдущий снимок хранит данные в JSON-блоке в конце markdown-файла\nlet prev = null;\nconst prevFile = $('GH prev snapshot').first().json;\nif (pick.prevPath && prevFile && prevFile.content) {\n  const text = Buffer.from(prevFile.content, 'base64').toString('utf8');\n  const m = text.match(/```json\\n([\\s\\S]*?)\\n```/);\n  if (m) {\n    try { prev = JSON.parse(m[1]); } catch (e) { prev = null; }\n  }\n}\n\nconst num = v => Number(v || 0);\nconst fmt = n => n.toLocaleString('de-DE');\nconst diff = (cur, old) => (old === undefined || old === null) ? null : cur - old;\nconst signed = d => d === null ? '—' : `${d >= 0 ? '+' : ''}${fmt(d)}`;\nconst paren = d => d === null ? '' : ` (${signed(d)})`;\nconst esc = s => String(s).replace(/\\|/g, '\\\\|');\nconst html = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst snapshot = {\n  date: pick.today,\n  channelId: ch.id,\n  title: ch.snippet.title,\n  subscribers: num(ch.statistics.subscriberCount),\n  views: num(ch.statistics.viewCount),\n  videos: num(ch.statistics.videoCount),\n  latest: vids.map(v => ({\n    id: v.id,\n    title: v.snippet.title,\n    publishedAt: v.snippet.publishedAt,\n    views: num(v.statistics.viewCount),\n    likes: num(v.statistics.likeCount),\n    comments: num(v.statistics.commentCount),\n  })),\n};\n\nconst prevVideo = id => (prev && prev.latest || []).find(v => v.id === id);\nconst d = {\n  subscribers: diff(snapshot.subscribers, prev && prev.subscribers),\n  views: diff(snapshot.views, prev && prev.views),\n  videos: diff(snapshot.videos, prev && prev.videos),\n};\n\nconst md = [\n  '---',\n  'source: \"YouTube Data API v3 через n8n (workflow channel-stats)\"',\n  `date: ${pick.today}`,\n  'tags:',\n  '  - статистика',\n  '  - канал',\n  '---',\n  '',\n  `# Статистика канала — ${pick.today}`,\n  '',\n  `Канал: **${esc(snapshot.title)}** (\\`${snapshot.channelId}\\`). ${prev ? `Δ — к снимку от ${prev.date}.` : 'Предыдущего снимка нет.'}`,\n  '',\n  '| Показатель | Значение | Δ |',\n  '| --- | --- | --- |',\n  `| Подписчики | ${fmt(snapshot.subscribers)} | ${signed(d.subscribers)} |`,\n  `| Просмотры | ${fmt(snapshot.views)} | ${signed(d.views)} |`,\n  `| Видео | ${fmt(snapshot.videos)} | ${signed(d.videos)} |`,\n  '',\n  '## Последние видео',\n  '',\n  '| Видео | Опубликовано | Просмотры | Δ | Лайки | Комментарии |',\n  '| --- | --- | --- | --- | --- | --- |',\n  ...snapshot.latest.map(v => {\n    const p = prevVideo(v.id);\n    return `| [${esc(v.title)}](https://youtu.be/${v.id}) | ${v.publishedAt.slice(0, 10)} | ${fmt(v.views)} | ${signed(diff(v.views, p && p.views))} | ${fmt(v.likes)} | ${fmt(v.comments)} |`;\n  }),\n  '',\n  '## Данные',\n  '',\n  '```json',\n  JSON.stringify(snapshot, null, 2),\n  '```',\n  '',\n].join('\\n');\n\nconst telegramText = [\n  `📊 <b>${html(snapshot.title)}</b> — ${pick.today}`,\n  '',\n  `👥 Подписчики: <b>${fmt(snapshot.subscribers)}</b>${paren(d.subscribers)}`,\n  `👁 Просмотры: <b>${fmt(snapshot.views)}</b>${paren(d.views)}`,\n  `🎬 Видео: <b>${fmt(snapshot.videos)}</b>${paren(d.videos)}`,\n  ...(snapshot.latest.length ? ['', '<b>Последние видео</b>'] : []),\n  ...snapshot.latest.map(v => {\n    const p = prevVideo(v.id);\n    return `• <a href=\"https://youtu.be/${v.id}\">${html(v.title)}</a> — ${fmt(v.views)}${paren(diff(v.views, p && p.views))}`;\n  }),\n].join('\\n');\n\nconst githubBody = {\n  message: `stats: снимок канала ${pick.today}`,\n  content: Buffer.from(md, 'utf8').toString('base64'),\n  branch: cfg.branch,\n};\nif (pick.todaySha) githubBody.sha = pick.todaySha;\n\nreturn [{ json: { path: pick.path, githubBody, telegramText } }];\n"
      },
      "id": "4c95f424-47d0-4bcf-bbbb-71cf27814483",
      "name": "Build snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        300
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://api.github.com/repos/{{ $('Config').first().json.githubOwner }}/{{ $('Config').first().json.githubRepo }}/contents/{{ $json.path }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "User-Agent",
              "value": "n8n-channel-project"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.githubBody) }}"
      },
      "id": "573bd192-c05d-4df0-8743-02e35780e436",
      "name": "GH commit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "githubToken",
          "name": "GitHub token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "chatId": "={{ $('Config').first().json.telegramChatId }}",
        "text": "={{ $('Build snapshot').first().json.telegramText + ($json.error ? '\\n\\n⚠️ Снимок не сохранён в GitHub' : '') }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      },
      "id": "c149b36f-427e-4c10-9db9-7c853ad72349",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2640,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegramBot",
          "name": "Telegram bot"
        }
      }
    }
